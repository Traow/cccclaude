{%- comment -%}
  DripMaster homepage – black & white streetwear section.
  Install: first add assets/dripmaster.css (Edit code → Assets → Add a new asset),
  then Edit code → Sections → Add a new section → "dripmaster-home" → paste this file → Save.
  Then Customize → Add section → "DripMaster homepage".
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">

{{ 'dripmaster.css' | asset_url | stylesheet_tag }}

<div class="dm" style="--dm-bg: {{ section.settings.color_bg }}; --dm-fg: {{ section.settings.color_fg }}; --dm-accent: {{ section.settings.color_accent }}; --dm-accent-text: {{ section.settings.color_accent_text }};">
  {%- if section.settings.bar_text != blank -%}
    <div class="dm-bar">{{ section.settings.bar_text }}</div>
  {%- endif -%}

  {%- comment -%} HERO {%- endcomment -%}
  <section class="dm-hero">
    <div class="dm-hero__row">
      <div class="dm-hero__title-wrap">
        {%- if section.settings.kicker != blank -%}
          <p class="dm-kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h1 class="dm-display dm-hero__title">
          {{ section.settings.title_1 }}<br>
          {{ section.settings.title_2 }}<br>
          <span class="dm-accent">{{ section.settings.title_3 }}</span>
        </h1>
      </div>
      <div class="dm-hero__side">
        {%- if section.settings.hero_text != blank -%}
          <p class="dm-hero__text">{{ section.settings.hero_text }}</p>
        {%- endif -%}
        <div class="dm-btns">
          {%- if section.settings.btn1_label != blank -%}
            <a class="dm-btn dm-btn--solid" href="{{ section.settings.btn1_link | default: '#dm-new' }}">{{ section.settings.btn1_label }}</a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a class="dm-btn" href="{{ section.settings.btn2_link | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="dm-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: section.settings.hero_image.alt }}
      {%- else -%}
        <div class="dm-placeholder">Add a campaign photo</div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} MARQUEE {%- endcomment -%}
  {%- if section.settings.marquee_text != blank -%}
    <div class="dm-marquee dm-display" aria-hidden="true">
      <div class="dm-marquee__track">
        {%- for i in (1..8) -%}{{ section.settings.marquee_text }} · {% endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} NEW DROP – products from a collection {%- endcomment -%}
  <section class="dm-section" id="dm-new">
    <div class="dm-head">
      <h2 class="dm-display dm-h2">{{ section.settings.products_title }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="dm-link" href="{{ section.settings.collection.url }}">View all →</a>
      {%- endif -%}
    </div>

    <div class="dm-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_count -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign tags_down = product.tags | join: ',' | downcase -%}
          {%- assign img_alt = product.featured_image.alt | default: product.title | escape -%}
          <article class="dm-card">
            <a class="dm-card__media" href="{{ product.url }}">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 25vw, 50vw', widths: '400, 600, 800', alt: img_alt }}
              {%- else -%}
                <div class="dm-placeholder">Product photo</div>
              {%- endif -%}
              {%- if product.available == false -%}
                <span class="dm-tag">Sold out</span>
              {%- elsif tags_down contains 'limited' -%}
                <span class="dm-tag">Limited</span>
              {%- elsif tags_down contains 'new' or tags_down contains 'uus' -%}
                <span class="dm-tag">New</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="dm-tag">Sale</span>
              {%- endif -%}
            </a>
            <div class="dm-card__info">
              <div>
                <h3 class="dm-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                {%- if product.vendor != blank and section.settings.show_vendor -%}
                  <p class="dm-card__sub">{{ product.vendor }}</p>
                {%- endif -%}
              </div>
              <p class="dm-card__price">
                {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                {{ product.price | money }}
              </p>
            </div>
            {%- if product.has_only_default_variant -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" class="dm-btn" {% unless variant.available %}disabled{% endunless %}>
                  {%- if variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                </button>
              {%- endform -%}
            {%- else -%}
              <a class="dm-btn" href="{{ product.url }}">Choose size</a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="dm-card">
            <div class="dm-card__media"><div class="dm-placeholder">Select a collection</div></div>
            <div class="dm-card__info">
              <div><h3 class="dm-card__title">Product name</h3></div>
              <p class="dm-card__price">€0.00</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} CATEGORIES – blocks {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <section class="dm-section dm-section--tight">
      <h2 class="dm-display dm-h2" style="margin-bottom: 40px;">{{ section.settings.categories_title }}</h2>
      <div class="dm-cats">
        {%- for block in section.blocks -%}
          {%- assign cat_url = block.settings.link | default: block.settings.collection.url | default: '#' -%}
          <a class="dm-cat" href="{{ cat_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 33vw, 100vw', alt: '' }}
            {%- elsif block.settings.collection.featured_image -%}
              {{ block.settings.collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 33vw, 100vw', alt: '' }}
            {%- endif -%}
            <span class="dm-display">{{ block.settings.title | default: block.settings.collection.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} NEWSLETTER {%- endcomment -%}
  {%- if section.settings.show_newsletter -%}
    <section class="dm-news">
      <div>
        <h2 class="dm-display">{{ section.settings.news_title }}</h2>
        <p>{{ section.settings.news_text }}</p>
      </div>
      {%- form 'customer', id: 'dm-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="dm-news__row">
          <label for="dm-email-{{ section.id }}" class="dm-sr">Email address</label>
          <input id="dm-email-{{ section.id }}" type="email" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
          <button type="submit">Join</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="dm-news__msg">Thanks! You're on the list.</p>
        {%- elsif form.errors -%}
          <p class="dm-news__msg">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "DripMaster homepage",
  "tag": "section",
  "class": "dm-section-wrapper",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#0B0B0B" },
    { "type": "color", "id": "color_fg", "label": "Text", "default": "#F2F0EA" },
    { "type": "color", "id": "color_accent", "label": "Accent (buttons, badges)", "default": "#F2F0EA" },
    { "type": "color", "id": "color_accent_text", "label": "Text on accent", "default": "#0B0B0B" },

    { "type": "header", "content": "Announcement bar" },
    { "type": "text", "id": "bar_text", "label": "Bar text", "default": "Free shipping over €50 · New drop out now" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "kicker", "label": "Small text above heading", "default": "Drop 01" },
    { "type": "text", "id": "title_1", "label": "Heading, line 1", "default": "Wear" },
    { "type": "text", "id": "title_2", "label": "Heading, line 2", "default": "your" },
    { "type": "text", "id": "title_3", "label": "Heading, line 3 (accent color)", "default": "drip." },
    { "type": "textarea", "id": "hero_text", "label": "Description", "default": "Streetwear for those who don't follow trends, they set them. Limited quantities, no restocks." },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Shop now" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "View collection" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" },
    { "type": "image_picker", "id": "hero_image", "label": "Campaign photo" },

    { "type": "header", "content": "Marquee" },
    { "type": "text", "id": "marquee_text", "label": "Text", "default": "No drip, no trip · Limited drops · DripMaster" },

    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_title", "label": "Heading", "default": "New drop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Number of products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "paragraph", "content": "Badges: add the tag 'new' or 'limited' to a product to show a badge on its card." },

    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "categories_title", "label": "Heading", "default": "Categories" },

    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter block", "default": true },
    { "type": "text", "id": "news_title", "label": "Heading", "default": "Don't sleep on the drop" },
    { "type": "text", "id": "news_text", "label": "Text", "default": "Join the list and hear about new drops before anyone else." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Name (blank = collection name)" },
        { "type": "image_picker", "id": "image", "label": "Image (blank = collection image)" },
        { "type": "url", "id": "link", "label": "Link (blank = collection link)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DripMaster homepage",
      "blocks": [
        { "type": "category", "settings": { "title": "Hoodies" } },
        { "type": "category", "settings": { "title": "T-shirts" } },
        { "type": "category", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
