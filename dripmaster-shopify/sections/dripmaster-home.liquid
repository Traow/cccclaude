{%- comment -%}
  DripMaster avaleht – must-valge streetwear sektsioon.
  Paigaldus: Online Store → Themes → … → Edit code → Sections → Add a new section
  → nimi "dripmaster-home" → kleebi see fail → Save.
  Siis Customize → Add section → "DripMaster avaleht".
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --dm-bg: {{ section.settings.color_bg }};
    --dm-fg: {{ section.settings.color_fg }};
    --dm-accent: {{ section.settings.color_accent }};
    --dm-accent-text: {{ section.settings.color_accent_text }};
    --dm-muted: #A8A59D;
    --dm-line: #262626;
    --dm-pad: clamp(16px, 4vw, 56px);
  }
  .dm { background: var(--dm-bg); color: var(--dm-fg); font-family: 'Space Grotesk', system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
  .dm *, .dm *::before, .dm *::after { box-sizing: border-box; }
  .dm a { color: var(--dm-fg); }
  .dm a:hover { color: var(--dm-muted); }
  .dm-display { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; line-height: 1; margin: 0; }
  .dm-accent { color: var(--dm-accent); }

  .dm-bar { background: var(--dm-accent); color: var(--dm-accent-text); text-align: center; padding: 10px 16px; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }

  .dm-hero { padding: clamp(48px, 8vw, 112px) var(--dm-pad) clamp(40px, 6vw, 80px); border-bottom: 1px solid var(--dm-line); }
  .dm-hero__row { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; }
  .dm-hero__title-wrap { flex: 999 1 520px; min-width: 0; }
  .dm-kicker { margin: 0 0 20px; font-size: 13px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--dm-accent); }
  .dm-hero__title { font-size: clamp(64px, 13vw, 200px); line-height: .88; letter-spacing: -.01em; }
  .dm-hero__side { flex: 1 1 320px; display: flex; flex-direction: column; gap: 24px; max-width: 420px; }
  .dm-hero__text { margin: 0; font-size: 18px; color: #BDBAB2; }
  .dm-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .dm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px; font-family: inherit; font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; cursor: pointer; border: 1px solid var(--dm-fg); background: transparent; color: var(--dm-fg); }
  .dm .dm-btn--solid { background: var(--dm-accent); border-color: var(--dm-accent); color: var(--dm-accent-text); }
  .dm .dm-btn--solid:hover { opacity: .85; color: var(--dm-accent-text); }
  .dm-btn:hover { opacity: .8; }
  .dm-hero__media { margin-top: 56px; height: clamp(280px, 40vw, 560px); border: 1px solid #2A2A2A; overflow: hidden; }
  .dm-hero__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dm-placeholder { width: 100%; height: 100%; background: repeating-linear-gradient(135deg, #161616 0 14px, #121212 14px 28px); display: flex; align-items: center; justify-content: center; color: #8A877F; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }

  .dm-marquee { background: var(--dm-fg); color: var(--dm-bg); padding: 14px 0; overflow: hidden; white-space: nowrap; font-size: 28px; letter-spacing: .04em; }
  .dm-marquee__track { display: inline-block; animation: dm-scroll 30s linear infinite; }
  @keyframes dm-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .dm-marquee__track { animation: none; } }

  .dm-section { padding: clamp(48px, 6vw, 96px) var(--dm-pad); }
  .dm-section--tight { padding-top: 0; }
  .dm-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 40px; }
  .dm-h2 { font-size: clamp(40px, 6vw, 72px); }
  .dm-link { font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  .dm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
  .dm-card { display: flex; flex-direction: column; gap: 14px; }
  .dm-card__media { position: relative; display: block; aspect-ratio: 4 / 5; background: #161616; border: 1px solid #2A2A2A; overflow: hidden; }
  .dm-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .dm-card__media:hover img { transform: scale(1.04); }
  .dm-tag { position: absolute; top: 12px; left: 12px; background: var(--dm-accent); color: var(--dm-accent-text); padding: 4px 10px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .dm-card__info { display: flex; justify-content: space-between; gap: 12px; }
  .dm-card__title { margin: 0; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .dm-card__title a { text-decoration: none; }
  .dm-card__sub { margin: 4px 0 0; font-size: 14px; color: var(--dm-muted); }
  .dm-card__price { margin: 0; font-weight: 700; white-space: nowrap; }
  .dm-card__price s { color: var(--dm-muted); font-weight: 400; margin-right: 6px; }
  .dm-card form { margin: 0; }
  .dm-card .dm-btn { width: 100%; min-height: 48px; }
  .dm-card .dm-btn[disabled] { opacity: .4; cursor: not-allowed; }

  .dm-cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .dm-cat { position: relative; min-height: 360px; display: flex; align-items: flex-end; padding: 28px; border: 1px solid #2A2A2A; text-decoration: none; overflow: hidden; background: repeating-linear-gradient(135deg, #161616 0 14px, #121212 14px 28px); }
  .dm-cat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dm-cat::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.7), rgba(0,0,0,0) 60%); }
  .dm-cat span { position: relative; z-index: 1; font-size: 48px; }

  .dm-news { margin: 0 var(--dm-pad) clamp(48px, 6vw, 96px); padding: clamp(32px, 5vw, 64px); background: var(--dm-accent); color: var(--dm-accent-text); display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .dm-news > div, .dm-news form { flex: 1 1 360px; }
  .dm-news h2 { font-size: clamp(36px, 5vw, 64px); }
  .dm-news p { margin: 12px 0 0; font-size: 17px; }
  .dm-news__row { display: flex; flex-wrap: wrap; gap: 12px; }
  .dm-news input[type="email"] { flex: 1 1 220px; min-height: 52px; padding: 0 16px; border: 2px solid var(--dm-bg); background: #fff; color: #0B0B0B; font-family: inherit; font-size: 16px; }
  .dm-news button { min-height: 52px; padding: 0 28px; background: var(--dm-bg); color: var(--dm-fg); border: none; font-family: inherit; font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .dm-news__msg { margin-top: 12px; font-weight: 700; }
  .dm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<div class="dm">
  {%- if section.settings.bar_text != blank -%}
    <div class="dm-bar">{{ section.settings.bar_text }}</div>
  {%- endif -%}

  {%- comment -%} HERO {%- endcomment -%}
  <section class="dm-hero">
    <div class="dm-hero__row">
      <div class="dm-hero__title-wrap">
        {%- if section.settings.kicker != blank -%}
          <p class="dm-kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h1 class="dm-display dm-hero__title">
          {{ section.settings.title_1 }}<br>
          {{ section.settings.title_2 }}<br>
          <span class="dm-accent">{{ section.settings.title_3 }}</span>
        </h1>
      </div>
      <div class="dm-hero__side">
        {%- if section.settings.hero_text != blank -%}
          <p class="dm-hero__text">{{ section.settings.hero_text }}</p>
        {%- endif -%}
        <div class="dm-btns">
          {%- if section.settings.btn1_label != blank -%}
            <a class="dm-btn dm-btn--solid" href="{{ section.settings.btn1_link | default: '#dm-new' }}">{{ section.settings.btn1_label }}</a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a class="dm-btn" href="{{ section.settings.btn2_link | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="dm-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: section.settings.hero_image.alt }}
      {%- else -%}
        <div class="dm-placeholder">Lisa kampaaniafoto</div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} JOOKSEV TEKST {%- endcomment -%}
  {%- if section.settings.marquee_text != blank -%}
    <div class="dm-marquee dm-display" aria-hidden="true">
      <div class="dm-marquee__track">
        {%- for i in (1..8) -%}{{ section.settings.marquee_text }} · {% endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} UUS DROP – tooted kollektsioonist {%- endcomment -%}
  <section class="dm-section" id="dm-new">
    <div class="dm-head">
      <h2 class="dm-display dm-h2">{{ section.settings.products_title }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="dm-link" href="{{ section.settings.collection.url }}">Vaata kõiki →</a>
      {%- endif -%}
    </div>

    <div class="dm-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_count -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign tags_down = product.tags | join: ',' | downcase -%}
          {%- assign img_alt = product.featured_image.alt | default: product.title | escape -%}
          <article class="dm-card">
            <a class="dm-card__media" href="{{ product.url }}">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 25vw, 50vw', widths: '400, 600, 800', alt: img_alt }}
              {%- else -%}
                <div class="dm-placeholder">Tootefoto</div>
              {%- endif -%}
              {%- if product.available == false -%}
                <span class="dm-tag">Välja müüdud</span>
              {%- elsif tags_down contains 'limited' -%}
                <span class="dm-tag">Limited</span>
              {%- elsif tags_down contains 'uus' -%}
                <span class="dm-tag">Uus</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="dm-tag">Sale</span>
              {%- endif -%}
            </a>
            <div class="dm-card__info">
              <div>
                <h3 class="dm-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                {%- if product.vendor != blank and section.settings.show_vendor -%}
                  <p class="dm-card__sub">{{ product.vendor }}</p>
                {%- endif -%}
              </div>
              <p class="dm-card__price">
                {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                {{ product.price | money }}
              </p>
            </div>
            {%- if product.has_only_default_variant -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" class="dm-btn" {% unless variant.available %}disabled{% endunless %}>
                  {%- if variant.available -%}Lisa korvi{%- else -%}Välja müüdud{%- endif -%}
                </button>
              {%- endform -%}
            {%- else -%}
              <a class="dm-btn" href="{{ product.url }}">Vali suurus</a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="dm-card">
            <div class="dm-card__media"><div class="dm-placeholder">Vali kollektsioon</div></div>
            <div class="dm-card__info">
              <div><h3 class="dm-card__title">Toote nimi</h3></div>
              <p class="dm-card__price">0,00 €</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} KATEGOORIAD – plokid {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <section class="dm-section dm-section--tight">
      <h2 class="dm-display dm-h2" style="margin-bottom: 40px;">{{ section.settings.categories_title }}</h2>
      <div class="dm-cats">
        {%- for block in section.blocks -%}
          {%- assign cat_url = block.settings.link | default: block.settings.collection.url | default: '#' -%}
          <a class="dm-cat" href="{{ cat_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 33vw, 100vw', alt: '' }}
            {%- elsif block.settings.collection.featured_image -%}
              {{ block.settings.collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 33vw, 100vw', alt: '' }}
            {%- endif -%}
            <span class="dm-display">{{ block.settings.title | default: block.settings.collection.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} UUDISKIRI {%- endcomment -%}
  {%- if section.settings.show_newsletter -%}
    <section class="dm-news">
      <div>
        <h2 class="dm-display">{{ section.settings.news_title }}</h2>
        <p>{{ section.settings.news_text }}</p>
      </div>
      {%- form 'customer', id: 'dm-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="dm-news__row">
          <label for="dm-email-{{ section.id }}" class="dm-sr">E-posti aadress</label>
          <input id="dm-email-{{ section.id }}" type="email" name="contact[email]" placeholder="sinu@email.ee" autocomplete="email" required>
          <button type="submit">Liitu</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="dm-news__msg">Aitäh! Oled listis.</p>
        {%- elsif form.errors -%}
          <p class="dm-news__msg">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "DripMaster avaleht",
  "tag": "section",
  "class": "dm-section-wrapper",
  "settings": [
    { "type": "header", "content": "Värvid" },
    { "type": "color", "id": "color_bg", "label": "Taust", "default": "#0B0B0B" },
    { "type": "color", "id": "color_fg", "label": "Tekst", "default": "#F2F0EA" },
    { "type": "color", "id": "color_accent", "label": "Aktsent (nupud, sildid)", "default": "#F2F0EA" },
    { "type": "color", "id": "color_accent_text", "label": "Tekst aktsendi peal", "default": "#0B0B0B" },

    { "type": "header", "content": "Ülemine riba" },
    { "type": "text", "id": "bar_text", "label": "Riba tekst", "default": "Tasuta tarne alates 50 € · Uus drop on väljas" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "kicker", "label": "Väike tekst pealkirja kohal", "default": "Drop 01" },
    { "type": "text", "id": "title_1", "label": "Pealkiri, rida 1", "default": "Kanna" },
    { "type": "text", "id": "title_2", "label": "Pealkiri, rida 2", "default": "oma" },
    { "type": "text", "id": "title_3", "label": "Pealkiri, rida 3 (aktsentvärv)", "default": "drippi." },
    { "type": "textarea", "id": "hero_text", "label": "Kirjeldus", "default": "Streetwear neile, kes ei oota trende, vaid teevad neid. Piiratud kogused, ei mingeid kordustrükke." },
    { "type": "text", "id": "btn1_label", "label": "Nupp 1 tekst", "default": "Osta kohe" },
    { "type": "url", "id": "btn1_link", "label": "Nupp 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Nupp 2 tekst", "default": "Vaata kollektsiooni" },
    { "type": "url", "id": "btn2_link", "label": "Nupp 2 link" },
    { "type": "image_picker", "id": "hero_image", "label": "Kampaaniafoto" },

    { "type": "header", "content": "Jooksev tekst" },
    { "type": "text", "id": "marquee_text", "label": "Tekst", "default": "No drip, no trip · Limited drops · DripMaster" },

    { "type": "header", "content": "Tooted" },
    { "type": "text", "id": "products_title", "label": "Pealkiri", "default": "Uus drop" },
    { "type": "collection", "id": "collection", "label": "Kollektsioon" },
    { "type": "range", "id": "products_count", "label": "Toodete arv", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_vendor", "label": "Näita brändi nime", "default": false },
    { "type": "paragraph", "content": "Sildid: lisa tootele tag 'uus' või 'limited', et kaardil silt kuvada." },

    { "type": "header", "content": "Kategooriad" },
    { "type": "text", "id": "categories_title", "label": "Pealkiri", "default": "Kategooriad" },

    { "type": "header", "content": "Uudiskiri" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Näita uudiskirja plokki", "default": true },
    { "type": "text", "id": "news_title", "label": "Pealkiri", "default": "Ära maga dropi maha" },
    { "type": "text", "id": "news_text", "label": "Tekst", "default": "Liitu listiga ja saa uutest dropidest teada enne teisi." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategooria",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektsioon" },
        { "type": "text", "id": "title", "label": "Nimi (tühjaks jättes kollektsiooni nimi)" },
        { "type": "image_picker", "id": "image", "label": "Pilt (tühjaks jättes kollektsiooni pilt)" },
        { "type": "url", "id": "link", "label": "Link (tühjaks jättes kollektsiooni link)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DripMaster avaleht",
      "blocks": [
        { "type": "category", "settings": { "title": "Hoodied" } },
        { "type": "category", "settings": { "title": "T-särgid" } },
        { "type": "category", "settings": { "title": "Aksessuaarid" } }
      ]
    }
  ]
}
{% endschema %}
